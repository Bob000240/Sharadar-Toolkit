# Copy to .env and fill in. The app reads these via python-dotenv.

# --- Database (TimescaleDB + pgvector) ---
# Either set DATABASE_URL directly, or the discrete DB_* vars below.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quorum_nexus
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quorum_nexus

# --- Task queue / object store (Phase 2) ---
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Upstream data sources ---
ALPACA_PUBLIC_KEY=
ALPACA_SECRET_KEY=
FRED_API_KEY=

# --- AI layer (provider-pluggable; kept until the Phase 3 rebuild) ---
OPENAI_API_KEY=
